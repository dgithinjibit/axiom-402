# ─────────────────────────────────────────────────────────────────────────────
# axiom-402-core — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values before running the CLI.
# NEVER commit the real .env to version control.
#
# Variable naming: all vars are prefixed AXIOM_ and read by the `config` crate
# via the SettlementConfig struct in crates/near-settlement/src/config.rs.
# ─────────────────────────────────────────────────────────────────────────────

# ── NEAR RPC ──────────────────────────────────────────────────────────────────

# JSON-RPC endpoint.  Testnet default shown.
AXIOM_NEAR_RPC_URL=https://rpc.testnet.near.org

# Network identifier used in explorer links and log output.
AXIOM_NETWORK_ID=testnet

# ── Contract ──────────────────────────────────────────────────────────────────

# Account ID of the deployed attestation contract.
AXIOM_CONTRACT_ID=attestation.testnet

# ── Signer ────────────────────────────────────────────────────────────────────

# The NEAR account that will sign anchor_proof transactions.
AXIOM_SIGNER_ACCOUNT_ID=your-agent.testnet

# Ed25519 private key in NEAR's `ed25519:<base58>` format.
# Generate with:  near generate-key your-agent.testnet
# WARNING: treat this value like a password — never log or commit it.
AXIOM_SIGNER_PRIVATE_KEY=ed25519:<your-private-key-base58>

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level for the CLI.  Supports standard tracing directives.
# Examples: info  |  debug  |  reasoning_engine=debug,near_settlement=info
AXIOM_LOG=info

# Set to "true" to emit structured JSON logs (useful for log aggregators).
AXIOM_LOG_JSON=false
